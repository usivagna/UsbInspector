<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="UsbInspector_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:UsbInspector_App"
    xmlns:vm="using:UsbInspector_App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="DetailRowTemplate" x:DataType="vm:DetailRow">
            <Grid Margin="0,3,0,3" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <FontIcon Grid.Column="1" FontSize="13" Glyph="&#xE946;" VerticalAlignment="Top" Margin="0,2,0,0"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          Visibility="{x:Bind HasHint, Converter={StaticResource BoolToVisibility}}"
                          ToolTipService.ToolTip="{x:Bind Hint}" />
                <TextBlock Grid.Column="2" Text="{x:Bind Value}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PortCardTemplate" x:DataType="vm:PortMapItem">
            <Button Click="PortCard_Click" Tag="{x:Bind}" Margin="0,4" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" ToolTipService.ToolTip="{x:Bind Route}">
                <Grid ColumnSpacing="10" Padding="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border BorderThickness="2" CornerRadius="3" Padding="8" VerticalAlignment="Top"
                            BorderBrush="{ThemeResource TextFillColorSecondaryBrush}">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{x:Bind LocationLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Identity}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Connection}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="Transparent">
            <AppBarButton Icon="Refresh" Label="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
            <AppBarButton Icon="Copy" Label="Copy summary" Command="{x:Bind ViewModel.CopyReportCommand}" />
            <AppBarButton Icon="Save" Label="Export JSON" Command="{x:Bind ViewModel.ExportCommand}" />
            <AppBarSeparator />
            <AppBarToggleButton Icon="Repair" Label="Advanced"
                                IsChecked="{x:Bind ViewModel.IsAdvancedMode, Mode=TwoWay}"
                                ToolTipService.ToolTip="Show technical details (descriptors, drivers, raw data)." />
            <AppBarButton Icon="Admin" Label="Run as administrator"
                          Command="{x:Bind ViewModel.RelaunchAsAdminCommand}"
                          Visibility="{x:Bind ViewModel.IsNotElevated, Mode=OneWay}" />
        </CommandBar>

        <!-- Elevation banner -->
        <InfoBar Grid.Row="1" Margin="0,4,0,8"
                 IsOpen="{x:Bind ViewModel.IsNotElevated, Mode=OneWay}"
                 IsClosable="False" Severity="Informational"
                 Title="See full USB4 details"
                 Message="Run as administrator to show complete USB4 speed &amp; connection details — the same information as the Windows Settings 'USB4 hubs and devices' page." />

        <Pivot Grid.Row="2" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
            <PivotItem Header="Device management">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Connected USB devices" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.InventorySummary, Mode=OneWay}" TextWrapping="Wrap" />
                        <ScrollViewer Grid.Row="2">
                            <StackPanel>
                                <TextBlock Text="All devices reported by the USB hub scan, including internal devices. Select one to inspect its port and disks."
                                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.ConnectedDevices}" ItemTemplate="{StaticResource PortCardTemplate}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <ScrollViewer Grid.Column="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.ComputerTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                     Title="Your port map · user-assigned schematic"
                                     Message="Windows does not provide a model-specific chassis drawing. Identify ports by plugging in a known device, then label the side and socket below. Positions are not to scale. USB 2/3 companion ports may represent one socket; internal and hub ports are also listed." />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="2" CornerRadius="12" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="FRONT" FontWeight="SemiBold" CharacterSpacing="120" />
                                        <TextBlock Text="User-labelled sockets" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.FrontPorts}" ItemTemplate="{StaticResource PortCardTemplate}" />
                                        <TextBlock Text="Assign a port below to place it here." TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="2" CornerRadius="12" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="REAR" FontWeight="SemiBold" CharacterSpacing="120" />
                                        <TextBlock Text="User-labelled sockets" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.RearPorts}" ItemTemplate="{StaticResource PortCardTemplate}" />
                                        <TextBlock Text="Assign a port below to place it here." TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Expander Header="Unassigned / other ports (including hubs and internal ports)"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.OtherPorts}" ItemTemplate="{StaticResource PortCardTemplate}" />
                            </Expander>
                            <TextBlock Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedPortRoute, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            <StackPanel Spacing="8" IsEnabled="{x:Bind ViewModel.CanLabelPort, Mode=OneWay}">
                                <ComboBox Header="Physical side (you identify)" ItemsSource="{x:Bind ViewModel.ChassisSides}"
                                          SelectedItem="{x:Bind ViewModel.SelectedChassisSide, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                <TextBox Header="Socket label (for example: upper left, blue socket)"
                                         Text="{x:Bind ViewModel.PortLabelDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" />
                                <Button Content="Save port label" Command="{x:Bind ViewModel.SavePortLabelCommand}" />
                                <TextBlock Text="To clear a saved location, choose Unassigned, erase the label, and save. Labels require an identifiable controller/hub route."
                                           TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.PortLayoutMessage, Mode=OneWay}" TextWrapping="Wrap" />
                            <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="Check before using a drive"
                                     Message="Compare the port, serial number, capacity and drive letter. Missing information is unknown, not proof that a disk is writable. This panel never formats or copies data." />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ManagementRows}" ItemTemplate="{StaticResource DetailRowTemplate}" />
                            <TextBlock Text="{x:Bind ViewModel.ScanNotes, Mode=OneWay}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </PivotItem>
            <PivotItem Header="Topology &amp; advanced details">
        <!-- Main content: tree + details -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <AutoSuggestBox Grid.Row="0" QueryIcon="Find" PlaceholderText="Search devices…"
                                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TreeView Grid.Row="1" x:Name="TopologyTree" SelectionMode="Single" ItemInvoked="TopologyTree_ItemInvoked"
                              ItemsSource="{x:Bind ViewModel.RootItems}">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="vm:UsbTreeItem">
                                <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="True">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="15" Glyph="{x:Bind Glyph}" />
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <FontIcon FontSize="12" Glyph="&#xE7BA;"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                  Visibility="{x:Bind HasWarnings, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <TextBlock Grid.Row="1" Text="No USB devices found. Click Refresh to scan."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                               Margin="16"
                               Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
            </Border>

            <!-- Details -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />

                <Pivot Grid.Row="1">
                    <PivotItem Header="Overview">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.OverviewRows}" ItemTemplate="{StaticResource DetailRowTemplate}" />
                        </ScrollViewer>
                    </PivotItem>
                    <PivotItem Header="Speed &amp; Power">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PowerRows}" ItemTemplate="{StaticResource DetailRowTemplate}" />
                        </ScrollViewer>
                    </PivotItem>
                    <PivotItem Header="USB-C"
                               Visibility="{x:Bind ViewModel.HasUsbCData, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.UsbCRows}" ItemTemplate="{StaticResource DetailRowTemplate}" />
                        </ScrollViewer>
                    </PivotItem>
                    <PivotItem Header="USB4"
                               Visibility="{x:Bind ViewModel.HasUsb4Data, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Usb4Rows}" ItemTemplate="{StaticResource DetailRowTemplate}" />
                        </ScrollViewer>
                    </PivotItem>
                    <PivotItem Header="Also here"
                               Visibility="{x:Bind ViewModel.HasAlsoHereData, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.AlsoHereRows}" ItemTemplate="{StaticResource DetailRowTemplate}" />
                        </ScrollViewer>
                    </PivotItem>
                    <PivotItem Header="Descriptors"
                               Visibility="{x:Bind ViewModel.IsAdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto">
                            <TextBlock Text="{x:Bind ViewModel.DescriptorsText, Mode=OneWay}"
                                       FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </PivotItem>
                    <PivotItem Header="Driver"
                               Visibility="{x:Bind ViewModel.IsAdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PnpRows}" ItemTemplate="{StaticResource DetailRowTemplate}" />
                        </ScrollViewer>
                    </PivotItem>
                    <PivotItem Header="Raw"
                               Visibility="{x:Bind ViewModel.IsAdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto">
                            <TextBlock Text="{x:Bind ViewModel.RawText, Mode=OneWay}"
                                       FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </PivotItem>
                </Pivot>
            </Grid>
        </Grid>
            </PivotItem>
        </Pivot>

        <!-- Live events -->
        <Expander Grid.Row="3" Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Expander.Header>
                <Grid HorizontalAlignment="Stretch">
                    <TextBlock Text="Live USB events (plug / unplug)" VerticalAlignment="Center" />
                    <HyperlinkButton Content="Clear" HorizontalAlignment="Right" Command="{x:Bind ViewModel.ClearLogCommand}" />
                </Grid>
            </Expander.Header>
            <ListView ItemsSource="{x:Bind ViewModel.EventLog}" Height="120"
                      SelectionMode="None" FontFamily="Consolas" />
        </Expander>

        <!-- Status bar -->
        <StackPanel Grid.Row="4" Orientation="Vertical" Margin="0,8,0,0">
            <TextBlock Text="{x:Bind ViewModel.StatusSummary, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.PowerDeliverySummary, Mode=OneWay}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <ProgressRing Grid.Row="2" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
