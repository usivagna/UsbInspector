<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="UsbInspector_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:UsbInspector_App"
    xmlns:vm="using:UsbInspector_App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="DetailRowTemplate" x:DataType="vm:DetailRow">
            <Grid Margin="0,3,0,3" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{x:Bind Value}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="Transparent">
            <AppBarButton Icon="Refresh" Label="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
            <AppBarButton Icon="Save" Label="Export JSON" Command="{x:Bind ViewModel.ExportCommand}" />
            <AppBarSeparator />
            <AppBarButton Icon="Admin" Label="Restart as Admin"
                          Command="{x:Bind ViewModel.RelaunchAsAdminCommand}"
                          Visibility="{x:Bind ViewModel.IsNotElevated, Mode=OneWay}" />
        </CommandBar>

        <!-- Elevation banner -->
        <InfoBar Grid.Row="1" Margin="0,4,0,8"
                 IsOpen="{x:Bind ViewModel.IsNotElevated, Mode=OneWay}"
                 IsClosable="False" Severity="Informational"
                 Title="Limited data"
                 Message="Running without administrator rights. Some descriptors may be unavailable — use 'Restart as Admin' for complete information." />

        <!-- Main content: tree + details -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
                <Grid>
                    <TreeView x:Name="TopologyTree" SelectionMode="Single" ItemInvoked="TopologyTree_ItemInvoked"
                              ItemsSource="{x:Bind ViewModel.RootItems}">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="vm:UsbTreeItem">
                                <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="True">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="15" Glyph="{x:Bind Glyph}" />
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <FontIcon FontSize="12" Glyph="&#xE7BA;"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                  Visibility="{x:Bind HasWarnings, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <TextBlock Text="No USB devices found. Click Refresh to scan."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                               Margin="16"
                               Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
            </Border>

            <!-- Details -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />

                <Pivot Grid.Row="1">
                    <PivotItem Header="Overview">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.OverviewRows}" ItemTemplate="{StaticResource DetailRowTemplate}" />
                        </ScrollViewer>
                    </PivotItem>
                    <PivotItem Header="Descriptors">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto">
                            <TextBlock Text="{x:Bind ViewModel.DescriptorsText, Mode=OneWay}"
                                       FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </PivotItem>
                    <PivotItem Header="PnP &amp; Driver">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PnpRows}" ItemTemplate="{StaticResource DetailRowTemplate}" />
                        </ScrollViewer>
                    </PivotItem>
                    <PivotItem Header="Power &amp; Speed">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PowerRows}" ItemTemplate="{StaticResource DetailRowTemplate}" />
                        </ScrollViewer>
                    </PivotItem>
                    <PivotItem Header="USB-C">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.UsbCRows}" ItemTemplate="{StaticResource DetailRowTemplate}" />
                        </ScrollViewer>
                    </PivotItem>
                    <PivotItem Header="USB4">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Usb4Rows}" ItemTemplate="{StaticResource DetailRowTemplate}" />
                        </ScrollViewer>
                    </PivotItem>
                    <PivotItem Header="Related">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.RelatedRows}" ItemTemplate="{StaticResource DetailRowTemplate}" />
                        </ScrollViewer>
                    </PivotItem>
                    <PivotItem Header="Port">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PortRows}" ItemTemplate="{StaticResource DetailRowTemplate}" />
                        </ScrollViewer>
                    </PivotItem>
                    <PivotItem Header="Raw">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto">
                            <TextBlock Text="{x:Bind ViewModel.RawText, Mode=OneWay}"
                                       FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </PivotItem>
                </Pivot>
            </Grid>
        </Grid>

        <!-- Live events -->
        <Expander Grid.Row="3" Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Expander.Header>
                <Grid HorizontalAlignment="Stretch">
                    <TextBlock Text="Live USB events (plug / unplug)" VerticalAlignment="Center" />
                    <HyperlinkButton Content="Clear" HorizontalAlignment="Right" Command="{x:Bind ViewModel.ClearLogCommand}" />
                </Grid>
            </Expander.Header>
            <ListView ItemsSource="{x:Bind ViewModel.EventLog}" Height="120"
                      SelectionMode="None" FontFamily="Consolas" />
        </Expander>

        <!-- Status bar -->
        <StackPanel Grid.Row="4" Orientation="Vertical" Margin="0,8,0,0">
            <TextBlock Text="{x:Bind ViewModel.StatusSummary, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.PowerDeliverySummary, Mode=OneWay}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <ProgressRing Grid.Row="2" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
